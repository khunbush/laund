generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SessionKind {
  LAUNDRY
  SNOOKER
  LUMP_SUM
}

model CollectionSession {
  id String @id @default(cuid())

  date DateTime @db.Date

  kind SessionKind @default(LAUNDRY)
  paid Boolean     @default(false)

  note1000 Int @default(0)
  note500  Int @default(0)
  note100  Int @default(0)
  note50   Int @default(0)
  note20   Int @default(0)
  coin10   Int @default(0)
  coin5    Int @default(0)
  coin2    Int @default(0)
  coin1    Int @default(0)

  totalBaht Int
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

/// One row per branch per day: the machine-reported revenue aggregated from an
/// imported washclub CSV. Re-importing a date range upserts these (idempotent).
model MachineDay {
  id       String   @id @default(cuid())
  branch   Int // 1 = washclub, 2 = washclub v2
  date     DateTime @db.Date
  revenue  Int // sum of transaction amounts (baht) for that branch/day
  txnCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branch, date])
  @@index([date])
}

/// One row per machine transaction, kept for time-of-day analysis. Only the
/// transactional CSV formats carry timestamps, so rows accumulate from daily
/// agent uploads (2026-07-09 onward); daily-summary backfills contribute none.
/// occurredAt stores the report's local (ICT) wall-clock time as if it were
/// UTC — read hours with getUTCHours, never convert.
model MachineTxn {
  id         String   @id @default(cuid())
  branch     Int // 1 = washclub, 2 = washclub v2
  occurredAt DateTime
  amount     Int // baht

  createdAt DateTime @default(now())

  @@index([branch, occurredAt])
}
