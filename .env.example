# Neon pooled connection string (used at runtime)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Neon direct/unpooled connection string (used only for migrations)
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# Shared passcode required to unlock the app
APP_PASSCODE="change-me"

# Random 32+ byte secret used to sign the auth session cookie (e.g. `openssl rand -hex 32`)
COOKIE_SECRET="change-me"
