# Neon pooled connection string (used at runtime)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Neon direct/unpooled connection string (used only for migrations)
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# Shared passcode required to unlock the app
APP_PASSCODE="change-me"

# Random 32+ byte secret used to sign the auth session cookie (e.g. `openssl rand -hex 32`)
COOKIE_SECRET="change-me"

# --- Optional: monthly CSV backup email (leave unset to disable) ---
# Free API key from https://resend.com (sign up with the same email as BACKUP_EMAIL;
# the onboarding@resend.dev sender can only deliver to the account owner's address)
RESEND_API_KEY=""
# Where to send the monthly backup
BACKUP_EMAIL=""
# Random secret; Vercel Cron authenticates to /api/backup with it (`openssl rand -hex 32`)
CRON_SECRET=""

# --- Optional: machine-data import for the Match page ---
# Bearer token your export agents send when POSTing washclub CSVs to
# /api/machine-import?branch=1|2 (`openssl rand -hex 32`). You can also just
# upload files manually in the app without setting this.
MACHINE_IMPORT_TOKEN=""
